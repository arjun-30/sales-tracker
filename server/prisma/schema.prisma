generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// super_admin sees every plant; admin runs one plant; sales_employee works
// in the field for one plant.
enum Role {
  admin
  sales_employee
  super_admin
}

enum DutyEndReason {
  manual
  timeout
  deactivated
}

enum OrderStatus {
  pending
  confirmed
  delivered
  cancelled
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  centerLat Float
  centerLng Float
  createdAt DateTime @default(now())

  users  User[]
  orders Order[]
  visits Visit[]
}

// A Roalux plant. Each has its own admins, salespeople, stores and prices.
// `code` (CHN) is part of every employee code at the plant: RLX-CHN-001.
model Plant {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
  visits Visit[]
  stores Store[]
  prices PlantPrice[]
}

// A plant's own price for one product size. Sizes without one sell at the
// company price on ProductVariant.
model PlantPrice {
  plantId   String
  variantId String
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  plant   Plant          @relation(fields: [plantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([plantId, variantId])
}

// A shop or dealer the plant supplies, pinned on the admin map.
model Store {
  id          String   @id @default(cuid())
  plantId     String
  name        String
  ownerName   String?
  phone       String?
  address     String?
  lat         Float
  lng         Float
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plant     Plant @relation(fields: [plantId], references: [id])
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([plantId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  // Staff ID with the plant in it (RLX-CHN-001) for sales employees; admins have none.
  employeeCode String?  @unique
  passwordHash String
  role         Role
  districtId   String?
  // Every admin and salesperson belongs to one plant; the super admin to none.
  plantId      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  district         District?         @relation(fields: [districtId], references: [id])
  plant            Plant?            @relation(fields: [plantId], references: [id])
  storesAdded      Store[]
  employeeLocation EmployeeLocation?
  locationHistory  LocationHistory[]
  orders           Order[]
  visits           Visit[]
  dutySessions     DutySession[]
}

// One stretch of on-duty time. Opened when the employee goes on duty, closed
// when they go off duty, are switched off by the silence sweep (endedAt = last
// location ping, not the sweep time), or are deactivated. Hours worked are the
// sum of these.
model DutySession {
  id        String         @id @default(cuid())
  userId    String
  startedAt DateTime       @default(now())
  endedAt   DateTime?
  endReason DutyEndReason?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model EmployeeLocation {
  id        String   @id @default(cuid())
  userId    String   @unique
  lat       Float
  lng       Float
  accuracy  Float?
  onDuty    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocationHistory {
  id         String   @id @default(cuid())
  userId     String
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  shortCode String   @unique
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  variants ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sizeLabel String
  unit      String
  price     Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  plantPrices PlantPrice[]

  @@unique([productId, sizeLabel])
}

model Order {
  id            String      @id @default(cuid())
  employeeId    String
  districtId    String
  // The salesperson's plant when the order was taken; a later transfer
  // leaves it with the plant it was taken for.
  plantId       String
  customerName  String
  customerPhone String?
  shopName      String?
  totalAmount   Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(pending)
  notes         String?
  lat           Float?
  lng           Float?
  createdAt     DateTime    @default(now())

  employee User        @relation(fields: [employeeId], references: [id])
  district District    @relation(fields: [districtId], references: [id])
  plant    Plant       @relation(fields: [plantId], references: [id])
  items    OrderItem[]

  @@index([employeeId, createdAt])
  @@index([districtId, createdAt])
  @@index([plantId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Visit {
  id          String    @id @default(cuid())
  employeeId  String
  districtId  String
  plantId     String
  shopName    String
  checkInAt   DateTime  @default(now())
  checkInLat  Float
  checkInLng  Float
  checkOutAt  DateTime?
  checkOutLat Float?
  checkOutLng Float?
  notes       String?

  employee User     @relation(fields: [employeeId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  plant    Plant    @relation(fields: [plantId], references: [id])

  @@index([employeeId, checkInAt])
  @@index([plantId, checkInAt])
}
