generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// super_admin sees every plant; admin runs one plant; sales_employee works
// in the field for one plant.
enum Role {
  admin
  sales_employee
  super_admin
}

enum DutyEndReason {
  manual
  timeout
  deactivated
}

enum OrderStatus {
  pending
  confirmed
  delivered
  cancelled
}

// Taken standing in the shop, or over the phone without a visit.
enum OrderChannel {
  in_person
  phone
}

// A shop a salesperson adds from the field waits for a plant admin to approve
// it; the office's own (typed or imported) are approved straight away.
enum StoreStatus {
  pending
  approved
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  centerLat Float
  centerLng Float
  createdAt DateTime @default(now())

  users  User[]
  orders Order[]
  visits Visit[]
}

// A Roalux plant. Each has its own admins, salespeople, stores and prices.
// `code` (CHN) is part of every employee code at the plant: RLX-CHN-001.
model Plant {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
  visits Visit[]
  stores Store[]
  prices PlantPrice[]
}

// A plant's own price for one product size. Sizes without one sell at the
// company price on ProductVariant.
model PlantPrice {
  plantId   String
  variantId String
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  plant   Plant          @relation(fields: [plantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([plantId, variantId])
}

// A shop or dealer the plant supplies, pinned on the admin map.
model Store {
  id          String      @id @default(cuid())
  plantId     String
  name        String
  ownerName   String?
  phone       String?
  address     String?
  lat         Float
  lng         Float
  notes       String?
  status      StoreStatus @default(approved)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plant     Plant   @relation(fields: [plantId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  orders    Order[]

  @@index([plantId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  // Staff ID with the plant in it (RLX-CHN-001) for sales employees; admins have none.
  employeeCode String?  @unique
  passwordHash String
  role         Role
  districtId   String?
  // Every admin and salesperson belongs to one plant; the super admin to none.
  plantId      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  district         District?         @relation(fields: [districtId], references: [id])
  plant            Plant?            @relation(fields: [plantId], references: [id])
  storesAdded      Store[]
  employeeLocation EmployeeLocation?
  locationHistory  LocationHistory[]
  orders           Order[]
  visits           Visit[]
  dutySessions     DutySession[]
}

// One stretch of on-duty time. Opened when the employee goes on duty, closed
// when they go off duty, are switched off by the silence sweep (endedAt = last
// location ping, not the sweep time), or are deactivated. Hours worked are the
// sum of these.
model DutySession {
  id        String         @id @default(cuid())
  userId    String
  startedAt DateTime       @default(now())
  endedAt   DateTime?
  endReason DutyEndReason?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model EmployeeLocation {
  id              String    @id @default(cuid())
  userId          String    @unique
  lat             Float
  lng             Float
  accuracy        Float?
  onDuty          Boolean   @default(false)
  // Where the employee has stayed (within a GPS-drift radius) and since when,
  // so the map can flag someone who hasn't moved for a long time.
  anchorLat       Float?
  anchorLng       Float?
  stationarySince DateTime?
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocationHistory {
  id         String   @id @default(cuid())
  userId     String
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  shortCode String   @unique
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  variants   ProductVariant[]
  orderItems OrderItem[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  sizeLabel String
  unit      String
  price     Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  plantPrices PlantPrice[]

  @@unique([productId, sizeLabel])
}

model Order {
  id                 String       @id @default(cuid())
  employeeId         String
  districtId         String
  // The salesperson's plant when the order was taken; a later transfer
  // leaves it with the plant it was taken for.
  plantId            String
  customerName       String
  customerPhone      String?
  shopName           String?
  totalAmount        Decimal      @db.Decimal(12, 2)
  status             OrderStatus  @default(pending)
  notes              String?
  lat                Float?
  lng                Float?
  channel            OrderChannel @default(in_person)
  // The shop on the map the order is for, when it is one. For an order taken
  // in person, how far the phone was from that shop: the office's check that
  // the salesperson was really there.
  storeId            String?
  distanceFromStoreM Int?
  createdAt          DateTime     @default(now())

  store     Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  employee  User            @relation(fields: [employeeId], references: [id])
  district  District        @relation(fields: [districtId], references: [id])
  plant     Plant           @relation(fields: [plantId], references: [id])
  items     OrderItem[]
  voiceNote OrderVoiceNote?

  @@index([employeeId, createdAt])
  @@index([districtId, createdAt])
  @@index([plantId, createdAt])
}

// A catalogue size (variantId), or a custom line for a size or pack the
// catalogue doesn't have, described and priced by the salesperson at the shop:
// customSize ("15 L") of a catalogue product (productId) or of a product named
// in customName.
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  variantId  String?
  productId  String?
  customName String?
  customSize String?
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// The customer's request recorded at the shop, for the office to listen to.
// Kept in the database (a minute is ~250 KB) so the backups cover it.
model OrderVoiceNote {
  orderId    String   @id
  mimeType   String
  durationMs Int?
  data       Bytes
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Visit {
  id          String    @id @default(cuid())
  employeeId  String
  districtId  String
  plantId     String
  shopName    String
  checkInAt   DateTime  @default(now())
  checkInLat  Float
  checkInLng  Float
  checkOutAt  DateTime?
  checkOutLat Float?
  checkOutLng Float?
  notes       String?

  employee User     @relation(fields: [employeeId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  plant    Plant    @relation(fields: [plantId], references: [id])

  @@index([employeeId, checkInAt])
  @@index([plantId, checkInAt])
}
