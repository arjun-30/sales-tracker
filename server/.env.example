DATABASE_URL="postgresql://painttracker:painttracker@localhost:5436/painttracker?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
SEED_ADMIN_PHONE="9999999999"
SEED_ADMIN_PASSWORD="admin123"
# Reverse proxies in front of the API (0 locally, 1 behind Caddy in production)
TRUST_PROXY=0
# Days of location history kept by `npm run prune:locations`
LOCATION_RETENTION_DAYS=90

# SMS to shop owners and plant admins (MSG91, DLT templates). Leave SMS_PROVIDER
# unset to only log messages; then the app shows the shop code itself (not in
# production). Each template's variables are ##var1##, ##var2##, ... in order:
#   STORE_OTP    code, salesperson, shop
#   ORDER_OWNER  order ref, shop, salesperson, item count ("3 items"), total
#   ORDER_ADMIN  salesperson, order ref, shop, item count, total
#   VISIT_OWNER  salesperson, shop, time
#   VISIT_ADMIN  salesperson, shop, time
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER=
MSG91_TEMPLATE_STORE_OTP=
MSG91_TEMPLATE_ORDER_OWNER=
MSG91_TEMPLATE_ORDER_ADMIN=
MSG91_TEMPLATE_VISIT_OWNER=
MSG91_TEMPLATE_VISIT_ADMIN=
# Order PDF to the shop owner on WhatsApp (Meta WhatsApp Cloud API). The
# template has a document header and body variables {{1}} order ref,
# {{2}} shop, {{3}} total. WHATSAPP_PROVIDER=meta to send.
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
