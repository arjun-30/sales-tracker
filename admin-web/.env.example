# Google Cloud Console -> APIs & Services -> Credentials -> Create API key.
# Enable the "Maps JavaScript API" for the project, and restrict the key to
# HTTP referrers (http://localhost:5173/* for dev) + that one API.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: only needed if admin-web isn't running against the default
# http://localhost:4000 server.
# VITE_API_URL=http://localhost:4000
