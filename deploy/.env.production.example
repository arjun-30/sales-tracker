# Copy to .env.production on the server and fill in every value.
# Generate secrets with: openssl rand -base64 48

# Domains (DNS A record for API_DOMAIN must point at this server)
API_DOMAIN=api.example.in
CORS_ORIGIN=https://admin.example.in

# Database (only reachable inside Docker)
POSTGRES_USER=painttracker
POSTGRES_PASSWORD=
POSTGRES_DB=painttracker

# Two different random secrets, 32+ characters each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# How long to keep location history (days)
LOCATION_RETENTION_DAYS=90
